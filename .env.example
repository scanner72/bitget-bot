BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSWORD=
PAPER=true

# Universe / auto-scan (USDT-M perps ONLY — no spot)
# SCAN_MODE=auto  -> top crypto USDT-M + top rToken/RWA stock perps by 24h quote volume
# SCAN_MODE=fixed -> use SYMBOLS list only
SCAN_MODE=auto
SCAN_CRYPTO_TOP=20
SCAN_RTOKEN_TOP=20
SCAN_REFRESH_SEC=300
# SYMBOLS used when SCAN_MODE=fixed (override). Compact BTCUSDT or ccxt BTC/USDT:USDT.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

TIMEFRAME=15m
POLL_SEC=60
ONCE=0
# Faster auto scans (default 200); raise for deeper history
OHLCV_LIMIT=200
# CANDIDATES_PATH=data/candidates.jsonl

# Agent decide (rules default; optional LLM via OpenAI-compatible API)
# AGENT_MODE=rules
# AGENT_MODE=llm
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SEC=8
# PROPOSED_SIZE_USD=100
# RSI_OVERBOUGHT=70
# RSI_OVERSOLD=30
# DECISIONS_PATH=data/decisions.jsonl

# Risk gate (paper)
# MAX_NOTIONAL_USD=100
# MAX_DAILY_LOSS_USD=50
# MAX_POSITIONS=8
# ONE_POSITION_PER_SYMBOL=true
# COOLDOWN_SEC=900
# ALLOWED_TYPES=BULLISH_DIV,BEARISH_DIV
# RISK_STATE_PATH=data/risk_state.json
# RISK_DECISIONS_PATH=data/decisions.jsonl

# Paper execution (no exchange keys; fills + open positions on disk)
# PAPER_FILLS_PATH=data/paper_fills.jsonl
# PAPER_POSITIONS_PATH=data/paper_positions.json

# Paper account / equity (cash wallet)
PAPER_START_BALANCE_USD=10000
# PAPER_ACCOUNT_PATH=data/paper_account.json


# Paper ATR exits (divergent-style TP/SL + risk exits)
# ATR = mean(high-low).tail(14), floor max(atr, entry*0.02)
# Long SL=entry-1*ATR TP1=+1.5*ATR TP2=+2.5*ATR (short mirrored)
# ATR_PCT_MIN=0.3
# ATR_PCT_MAX=6.0
# BE_HOURS=8
# MAX_HOLD_HOURS=48
# EXIT_CHECK_SEC=0
# ENABLE_TRAILING=true
# MAX_LOSS_PCT_OF_MARGIN=0
# DOLLAR_STOP_SL_PCT_THRESHOLD=0.70
# EARLY_CLOSE_HOURS=0
# EARLY_CLOSE_LOSS_PCT=20
# PAPER_LEVERAGE=1
