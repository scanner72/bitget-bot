# Bitget S2 Divergent Agent Desk — recommended demo stack (hub_demo + paper shadow)
# Mirrors live desk 2026-09-16. Policy: .cursor/rules/desk-config.mdc (beats v1 / old docs).
PAPER=true
EXEC_MODE=hub_demo
BITGET_DEMO=1
BITGET_ALLOW_LIVE=0
HUB_SYNC_EXCHANGE_SL=1
# Cap on adaptive leverage: max(2, min(HUB_LEVERAGE, int(35 / SL%))).
# Same $500 notional; higher lev only reduces margin. Not PAPER_LEVERAGE.
HUB_LEVERAGE=20

# Bitget UTA Demo credentials (paptrading) — do not commit real values
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# BITGET_DEMO_API_KEY=
# BITGET_DEMO_SECRET_KEY=
# BITGET_DEMO_PASSPHRASE=
# BITGET_HTTP_TIMEOUT_SEC=20
# Per-symbol price decimals override, e.g. BITGET_PRICE_DECIMALS_DOGEUSDT=5

# Universe / auto-scan (USDT-M perps ONLY — no spot)
# SCAN_MODE=auto  -> top crypto USDT-M + top rToken/RWA stock perps by 24h quote volume
# SCAN_MODE=fixed -> use SYMBOLS list only
SCAN_MODE=auto
SCAN_CRYPTO_TOP=70
SCAN_RTOKEN_TOP=30
SCAN_REFRESH_SEC=300
# SYMBOLS used when SCAN_MODE=fixed (override). Compact BTCUSDT or ccxt BTC/USDT:USDT.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Always-on: USDCUSDT. Comma list of extra Bitget ids / ccxt symbols to never scan or open.
# TRADE_DENY_SYMBOLS=

# Comma list: desk loop + public WS scan each TF (TIMEFRAMES wins if both set)
TIMEFRAMES=15m,1h,4h
TIMEFRAME=15m,1h,4h
POLL_SEC=60
ONCE=0
# Market data: ws = public Bitget candles/tickers (exec still REST hub_demo)
MARKET_DATA_MODE=ws
# WS_MAX_CHANNELS_PER_CONN=40
# WS_BOOTSTRAP_RATE=8
# BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public
# Faster auto scans (default 200); raise for deeper history
OHLCV_LIMIT=200
# CANDIDATES_PATH=data/candidates.jsonl

# Agent decide (rules default; LLM via OpenAI-compatible API)
# Groq: https://api.groq.com/openai/v1  model=qwen/qwen3.6-27b (or openai/gpt-oss-20b)
# Bitget S2 Qwen proxy (if you get that key): https://hackathon.bitgetops.com/v1  qwen3.8-max
AGENT_MODE=rules
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.6-27b
OPENAI_TIMEOUT_SEC=20
# PROPOSED_SIZE_USD=100
# RSI_OVERBOUGHT=70
# RSI_OVERSOLD=30
# DECISIONS_PATH=data/decisions.jsonl

# Risk gate
# MAX_NOTIONAL_USD=100
# RISK_USD_PER_TRADE=2
# MIN_NOTIONAL_USD=10
MAX_DAILY_LOSS_USD=150
MAX_POSITIONS=15
MAX_SAME_DIRECTION_POSITIONS=4
# ONE_POSITION_PER_SYMBOL=true
# signal_cooldown_minutes=15 → seconds
COOLDOWN_SEC=900
# Detector still has LEVEL_CROSS_UP (short); desk does not allow it
ALLOWED_TYPES=BULLISH_DIV,BEARISH_DIV,LEVEL_CROSS_DOWN
# RISK_STATE_PATH=data/risk_state.json
# RISK_DECISIONS_PATH=data/decisions.jsonl

# Side policy (v1: both long and short)
ALLOW_LONG=1
ALLOW_SHORT=1
# 0 = off. Signal-bar RSI on bullish div is almost always >30; do not restore 30
RSI_LONG_MAX=0

# Pair / TF performance bans (divergent pair_blocker + timeframe_blocker)
PAIR_BLOCKER_ENABLED=1
PAIR_BLOCKER_INTERVAL_SEC=600
BLOCK_MIN_TRADES=4
BLOCK_WR_THRESHOLD=30
BLOCK_CONSECUTIVE_LOSSES=3
BLOCK_COOLDOWN_HOURS=48
BLOCK_STATS_WINDOW_DAYS=14
BLOCK_LONGTAIL_WINDOW_DAYS=60
BLOCK_LONGTAIL_WR_THRESHOLD=20
BLOCK_PNL_MIN_TRADES=5
BLOCK_PNL_COOLDOWN_HOURS=336
# Off 2026-09-14 (15m-only book). Still off now that the desk scans 15m,1h,4h.
# Pair blocker stays on. Do not re-enable unless the user asks.
TF_BLOCKER_ENABLED=0
TF_BLOCK_MIN_TRADES=30
TF_BLOCK_WINDOW_DAYS=30
TF_BLOCK_COOLDOWN_HOURS=168
# PAIR_BLOCKS_PATH=data/pair_blocks.json

# BTC filters (v1 symmetric: block long in bearish / short in bullish).
# EMA50 off to match live divergent DB. Regime TF=4h (same as v1 live DB).
BTC_FILTERS_ENABLED=1
BTC_REGIME_ENABLED=1
BTC_REGIME_TF=4h
BTC_MOMENTUM_PCT=1.2
BTC_MOMENTUM_HOURS=4
BTC_EMA50_FILTER_ENABLED=0
# BTC_FILTER_SYMBOL=BTC/USDT:USDT

# Paper shadow (fills + open positions on disk; synced with hub_demo)
# PAPER_FILLS_PATH=data/paper_fills.jsonl
# PAPER_POSITIONS_PATH=data/paper_positions.json

# Paper account / equity overlay (Demo UTA equity merged in hub_demo)
PAPER_START_BALANCE_USD=10000
# DEMO_START_EQUITY=10000
# Fixed Demo equity anchor for UI drawdown (default: PAPER_START_BALANCE_USD).
# Do not set this to the current wallet — that hid losses.
# PAPER_ACCOUNT_PATH=data/paper_account.json

# Paper↔Bitget reconcile (hub_demo/live): close local ghosts missing on exchange
# RECONCILE_ENABLED=1
# RECONCILE_GRACE_SEC=60

# hub_demo scans the full Demo UTA catalog (not public top-N).
# PAPER_FALLBACK=1 restores paper-live fills for live-only names; that PnL is not Demo equity.
PAPER_FALLBACK=0
# PAPER_FALLBACK_SLIPPAGE_BPS=2
# DEMO_UNIVERSE_TTL_SEC=600

# ATR exits: TP1 partial close + SL to breakeven; exchange SL+TP2 parachute on open (hub_demo)
# TP1_CLOSE_FRACTION=0.5  (0 = breakeven only, no partial)
# Tick path: full evaluate_exit (SL/TP1/TP2/trail/ATR from WS cache) on each quote
# for currently open positions. 30s loop remains the backup. TICK_STOPS=0 to disable.
TICK_STOPS=1
# P1: after TP1 / trailing active, SL is hard-clamped to breakeven (never losing side)
# ATR = mean(high-low).tail(14), floor max(atr, entry*0.02)
# Long SL=entry-1*ATR TP1=+1.5*ATR TP2=+2.5*ATR (short mirrored)
ATR_PCT_MIN=0.3
ATR_PCT_MAX=6.0
# rToken / stock perps: 1h ATR, no 2% crypto floor. Weekends stay open (24/7 venue).
# Quiet mega-cap fails min 0.5% instead of opening with unreachable 3% TP.
RTOKEN_ATR_TF=1h
RTOKEN_ATR_FLOOR_PCT=0
RTOKEN_ATR_PCT_MIN=0.5
# Skip ENTER when Demo mark/fill diverges from public mark (or signal) beyond this %.
# 2.5%: catches BZ stocks (~4.5%) and LTC crypto Demo premium (~3% vs public).
# Old crypto 5% let LTC 59.78 vs public 58.02 through.
SIGNAL_PRICE_MAX_DEV_PCT=2.5
RTOKEN_SIGNAL_PRICE_MAX_DEV_PCT=2.5
# Exit-path: drop a public tick that disagrees with Demo entry (or candle).
# 2.5%: LTC paper closed @57.99 vs entry 59.78 (−15 paper) while hub was −0.26.
MARK_SANITY_MAX_DEV_PCT=2.5
RTOKEN_MARK_SANITY_MAX_DEV_PCT=2.5
BE_HOURS=8
MAX_HOLD_HOURS=48
# EXIT_CHECK_SEC=0
ENABLE_TRAILING=true
MAX_LOSS_PCT_OF_MARGIN=40
DOLLAR_STOP_SL_PCT_THRESHOLD=0
EARLY_CLOSE_HOURS=3
EARLY_CLOSE_LOSS_PCT=20
# PAPER_LEVERAGE=1  (paper dollar-stop only; size_usd is notional. Exchange leverage is HUB_LEVERAGE=20)

# Execution backend: paper (local only) | hub_demo (Bitget Demo UTA + paper shadow) | live (guarded)
# EXEC_MODE=paper
RISK_USD_PER_TRADE=10
MAX_NOTIONAL_USD=500

# Option 2: shorts only when BTC 4h regime is bearish (neutral/bullish block shorts)
BTC_SHORT_ONLY_BEARISH=1

